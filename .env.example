# Copy to .env and fill in. Never commit .env.
# NWS requires a User-Agent that identifies the application and a contact e-mail.
NWS_USER_AGENT=(ud-flood-monitor-team2, your.email@example.com)

# Docker / Airflow
AIRFLOW_UID=50000
AIRFLOW_SECRET_KEY=change-me
AIRFLOW_ADMIN_PASSWORD=admin

# Workshop 3: Spark heap for the Gold DAG (local mode). Raise to 2g if the laptop has 16 GB.
SPARK_DRIVER_MEMORY=1g
