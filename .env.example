# Copy to .env and fill in. Never commit .env.
# NWS requires a User-Agent that identifies the application and a contact.
NWS_USER_AGENT=(ud-flood-monitor-team2, your.email@example.com)

# Database (used from Workshop 2 on)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=flood_monitor
POSTGRES_USER=flood
POSTGRES_PASSWORD=change-me
